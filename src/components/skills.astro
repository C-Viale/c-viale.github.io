---
import Section from "./section.astro";
import { stack } from "src/utils/constants/stack";
import StackTag from "./stack-tag.astro";

interface Props {
  title?: string;
}

const { title = "Skills" } = Astro.props;
---

<Section name={title}>
  <div class="stack-container">
    {stack.map((skill) => <StackTag name={skill} />)}
  </div>
</Section>

<style is:global>
  .stack-container {
    display: flex;
    padding: 1rem;
    gap: 1rem;
    max-width: 500px;
    margin: auto;
    justify-content: center;
  }
</style>
