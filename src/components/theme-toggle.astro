---
import IconButton from "./icon-button.astro";
import Moon from "./icons/moon.astro";
import Sun from "./icons/sun.astro";
---

<IconButton class="theme-toggle" title="Toggle theme">
  <Moon className="theme-toggle-moon" size={16} />
  <Sun className="theme-toggle-sun" size={22} />
</IconButton>

<style is:global>
  .theme-toggle {
    width: 20px;
  }

  .theme-toggle-moon {
    display: none;
    body.dark & {
      display: initial;
    }
  }

  .theme-toggle-sun {
    display: initial;
    body.dark & {
      display: none;
    }
  }
</style>

<script>
  function handler() {
    if (document.body.classList.contains("light")) {
      document.body.classList.replace("light", "dark");
      localStorage.setItem("theme", "dark");
    } else {
      document.body.classList.replace("dark", "light");
      localStorage.setItem("theme", "light");
    }
  }

  function setupHandlers() {
    const buttons = document.querySelectorAll(".theme-toggle");
    for (const button of buttons) {
      button.addEventListener("click", handler);
    }
  }

  document.addEventListener("astro:page-load", setupHandlers);
</script>
