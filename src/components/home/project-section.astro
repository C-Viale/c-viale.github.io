---
import athens_portal from "#assets/athens-portal/logo.jpeg";
import ProjectCard from "#components/project-card.astro";
import { projects } from "#constants/projects";
import HomeSection from "./home-section.astro";

const imgs: Record<string, ImageMetadata> = {
  athens_portal,
};
---

<HomeSection title="Projects">
  {
    projects.map((project) => (
      <ProjectCard
        href={project.href}
        name={project.name}
        description={project.description}
        image={imgs[project.id]}
      />
    ))
  }
</HomeSection>

<style is:global>
  #projects_content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0 2rem;

    @media (max-width: 767px) {
      grid-template-columns: 1fr;
    }
  }
</style>
