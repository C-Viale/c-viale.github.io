---
import { slugify } from "src/utils/functions/slugify";

interface Props {
  title: string;
  heading?: 1 | 2 | 3 | 4 | 5 | 6;
}

const { title } = Astro.props;

const id = slugify(title);
const titleId = `${id}_title`;
const contentId = `${id}_content`;
---

<section id={id} class="home-segment" aria-labelledby={titleId}>
  <h2 id={titleId}>{title}</h2>
  <div id={contentId}>
    <slot />
  </div>
</section>

<style is:global>
  .home-segment {
    padding: 1.5rem 0;
    margin-bottom: 1rem;

    > h2 {
      text-align: center;
      margin-bottom: 2rem;
    }

    > div {
      max-width: 800px;
      margin: auto;
    }
  }
</style>
