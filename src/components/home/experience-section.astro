---
import { workExperiences } from "#constants/work-experiences";
import HomeSection from "./home-section.astro";
---

<HomeSection title="Work Experience">
  <ul id="work-experiences-list">
    {
      workExperiences.map((experience) => (
        <li class="work-experience">
          <header>
            <h3>
              <strong>{experience.position}</strong>
              at
              <strong>{experience.company}</strong>
              {experience.freelancer && (
                <span class="freelancer-mark"> - Freelance</span>
              )}
            </h3>
            <span>{experience.period.join(" - ")}</span>
          </header>
          <ul class="work-experience-details">
            {experience.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</HomeSection>

<style is:global>
  #work-experiences-list {
    list-style: none;
    padding: 0 2rem;
  }

  .work-experience {
    padding: 1rem;
    border-width: 1px 1px 1px 1px;
    margin-top: -1px;
    color: var(--text-subtle);
    background-color: var(--bg-dark);
    transition: all var(--transition);
    border-color: var(--border);

    > header {
      display: flex;
      justify-content: space-between;
      font-weight: 400 !important;

      h3 {
        font-weight: normal;
      }

      strong {
        font-weight: 600 !important;
        color: var(--text);
      }
    }
  }

  .freelancer-mark {
    font-size: 0.9rem;
  }
  .work-experience-details {
    padding: 1rem;
    color: var(--text-subtle);
  }

  @media (max-width: 767px) {
  }
</style>
