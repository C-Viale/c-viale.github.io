---
import { milestones, workExperiences } from "#constants/work-experiences";
import HomeSection from "./home-section.astro";
import TimelineMilestone from "#components/timeline-milestone.astro";
---

<HomeSection title="Work Experience">
  <div class="timeline">
    {
      workExperiences.map((experience, index) => {
        const milestoneBefore = milestones.find(
          (milestone) => milestone.beforeId === experience.id,
        );
        const milestoneAfter = milestones.find(
          (milestone) => milestone.afterId === experience.id,
        );

        const className =
          index % 2 === 0 ? "timeline-item--left" : "timeline-item--right";
        const detailsId = `experience-details-${experience.id}`;

        return (
          <>
            {milestoneAfter && (
              <TimelineMilestone
                label={milestoneAfter.label}
                period={milestoneAfter.period}
              />
            )}
            <div class:list={["timeline-item", className]}>
              <div class="timeline-dot" />
              <article class="timeline-card">
                <header class="timeline-card-header">
                  <h3 class="timeline-card-role">{experience.position}</h3>
                  <p class="timeline-card-company">{experience.company}</p>
                  <p class="timeline-card-period">
                    {experience.period.join(" – ")}
                  </p>
                  <p class="timeline-card-location">{experience.location}</p>
                  {experience.freelancer && (
                    <p class="freelancer-mark">Freelance</p>
                  )}
                </header>
                <div class="timeline-card-details-wrap">
                  <div
                    id={detailsId}
                    class="timeline-card-expandable"
                    aria-hidden="true"
                  >
                    <ul class="timeline-card-details">
                      {experience.details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                    <div class="timeline-card-skills">
                      <h4 class="timeline-card-skills-title">Main Skills</h4>
                      <p class="timeline-card-skills-list">
                        {experience.mainSkills.join(", ")}
                      </p>
                    </div>
                  </div>
                </div>
                <button
                  type="button"
                  class="timeline-card-toggle"
                  aria-expanded="false"
                  aria-controls={detailsId}
                >
                  See more
                </button>
              </article>
            </div>
            {milestoneBefore && (
              <TimelineMilestone
                label={milestoneBefore.label}
                period={milestoneBefore.period}
              />
            )}
          </>
        );
      })
    }
  </div>
</HomeSection>

<script>
  function init() {
    const toggles = document.querySelectorAll(".timeline-card-toggle");

    for (const toggle of toggles) {
      toggle.addEventListener("click", () => {
        const button = toggle as HTMLButtonElement;
        const card = button.closest(".timeline-card");
        if (!card) return;

        const expandable = card.querySelector(".timeline-card-expandable");
        const expanded = button.getAttribute("aria-expanded") === "true";
        const nextExpanded = !expanded;

        button.setAttribute("aria-expanded", String(nextExpanded));
        button.textContent = nextExpanded ? "See less" : "See more";
        card.classList.toggle("is-expanded", nextExpanded);

        if (expandable) {
          expandable.setAttribute("aria-hidden", String(!nextExpanded));
        }
      });
    }
  }

  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  #work-experience_content {
    max-width: 1100px;
  }

  .timeline {
    position: relative;
    padding: 0 2rem;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background-color: var(--border);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr 2rem 1fr;
    align-items: start;
    padding-bottom: 2rem;
    position: relative;
  }

  .timeline-item--left .timeline-card {
    grid-column: 1;
    grid-row: 1;
    text-align: right;
  }

  .timeline-item--right .timeline-card {
    grid-column: 3;
    grid-row: 1;
  }

  .timeline-dot {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    width: 12px;
    height: 12px;
    margin-top: 1.25rem;
    border-radius: 50%;
    background-color: var(--bg-dark);
    border: 2px solid var(--text);
    z-index: 1;
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    color: var(--text-subtle);
    background-color: var(--bg-dark);
    border: 1px solid var(--border);
    transition: all var(--transition);
  }

  .timeline-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .timeline-card-role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .timeline-card-company {
    font-size: 0.95rem;
    color: var(--text);
  }

  .timeline-card-period,
  .timeline-card-location,
  .freelancer-mark {
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .timeline-card-details-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition);
  }

  .timeline-card.is-expanded .timeline-card-details-wrap {
    grid-template-rows: 1fr;
  }

  .timeline-card-expandable {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .timeline-card.is-expanded .timeline-card-expandable {
    opacity: 1;
    padding-top: 0.75rem;
  }

  .timeline-card-details {
    color: var(--text);
    list-style-position: inside;
    list-style-type: none;

    > li {
      margin-bottom: 1rem;
    }
  }

  .timeline-card-skills {
    margin-top: 0.25rem;
  }

  .timeline-card-skills-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .timeline-card-skills-list {
    font-size: 0.9rem;
    color: var(--text-subtle);
  }

  .timeline-card-toggle {
    align-self: flex-start;
    margin-top: 0.75rem;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.9rem;
    color: var(--text);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color var(--transition);
  }

  .timeline-card-toggle:hover {
    color: var(--text-subtle);
  }

  .timeline-item--left .timeline-card-toggle {
    align-self: flex-end;
  }

  @media (max-width: 767px) {
    .timeline {
      padding: 0 1.5rem 0 0;
    }

    .timeline::before {
      left: 1.45rem;
      transform: none;
    }

    .timeline-item {
      grid-template-columns: 2rem 1fr;
      padding-left: 0.5rem;
    }

    .timeline-item--left .timeline-card,
    .timeline-item--right .timeline-card {
      grid-column: 2;
      text-align: left;
    }

    .timeline-dot {
      grid-column: 1;
    }

    .timeline-item--left .timeline-card-toggle {
      align-self: flex-start;
    }
  }
</style>
