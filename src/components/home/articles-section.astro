---
import ArticleCard from "#components/article-card.astro";
import { articles } from "#constants/articles";
import dayjs from "dayjs";
import HomeSection from "./home-section.astro";
---

<HomeSection title="Articles">
  {articles
    .toSorted((a, b) => (dayjs(a.date).isBefore(b.date) ? 1 : -1))
    .map((article) => (
      <ArticleCard
        href={"articles/" + article.slug}
        title={article.title}
        description={article.description}
        date={article.date}
      />
    ))}
</HomeSection>

<style is:global>
  #articles_content {
    display: grid;
    padding: 0 2rem;

    @media (max-width: 767px) {
      grid-template-columns: 1fr;
    }
  }
</style>
