---
import me from "#assets/me.jpeg";
import { Image } from "astro:assets";
import HomeSection from "./home-section.astro";
import Anchor from "#components/anchor.astro";
import ProgrammingIcon from "#components/icons/programming-icon.astro";
import { skillIconOrder } from "#constants/stack";
---

<HomeSection title="About me" hideTitle transparent>
  <div id="info_container">
    <Image src={me} alt="An image of myself" height={248} />
    <div id="info_text">
      <h1>Hello!</h1>
      <h1>My name is Caio Viale and I'm a dedicated Full-Stack developer</h1>
      <p>
        With 6+ years of programming experience, I specialize in building
        sophisticated web applications.
      </p>

      <div id="my-links">
        <Anchor
          button
          label="LinkedIn"
          href="https://linkedin.com/in/caio-vlima"
        />
        <Anchor button label="GitHub" href="https://github.com/C-Viale" />
      </div>
    </div>
  </div>
  <div id="skill-icons">
    {skillIconOrder.map((name) => <ProgrammingIcon name={name} hover />)}
  </div>

  <p id="extra-info">
    I am deeply engaged in researching new technologies and advance my skills to
    deliver products that optimize user experiences and operational efficiency.
  </p>
</HomeSection>

<style is:global>
  #about-me {
    padding-top: 3.5rem;
  }
  #info_container {
    display: flex;
    gap: 3rem;
    max-width: 906px;
    height: 248px;
    margin-bottom: 3rem;
    h1 {
      font-size: 20px;
    }

    p {
      font-size: 14px;
    }

    img {
      box-shadow:
        -4px -4px 0 0 #616161,
        -9px -9px 0 0 #373737;
    }
  }

  #info_text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;

    justify-content: center;
    max-width: 610px;
  }

  #my-links {
    display: flex;
    list-style: none;
    gap: 1rem;
  }

  #skill-icons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
    padding: 0 2rem 1.75rem;
  }

  #extra-info {
    font-size: 24px !important;
    text-align: center;
    padding: 0 2rem;
  }

  @media (max-width: 767px) {
    #info_container {
      height: unset;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 1.5rem;
    }

    #my-links {
      justify-content: center;
    }
  }
</style>
