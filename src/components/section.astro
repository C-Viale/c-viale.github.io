---
import { slugify } from "src/utils/functions/slugify";

interface Props {
  name: string;
}

const { name } = Astro.props;

const id = slugify(name);
const titleId = id + "-title";
---

<section id={id} aria-labelledby={titleId}>
  <h2 id={titleId}>{name}</h2>
  <div>
    <slot />
  </div>
</section>

<style is:global>
  section {
    margin-bottom: 2rem;

    h2 {
      margin-bottom: 0.5rem;
    }
  }
</style>
