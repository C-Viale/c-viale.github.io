---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ImageSlash from "./image-slash.astro";

interface Props {
  name: string;
  description?: string;
  image?: ImageMetadata;
  href: string;
}

const { name, image, description, href } = Astro.props;

const alt = `Image of "${name}"" project`;
---

<a class="project-card" href={href}>
  <div class="project-img">
    {
      image ? (
        <Image src={image} alt={alt} width={60} />
      ) : (
        <ImageSlash size={30} />
      )
    }
  </div>
  <div class="project-info">
    <h3>{name}</h3>
    <p>{description}</p>
  </div>
</a>

<style is:global>
  .project-info {
    flex: 1;

    h3 {
      font-size: 16px;
    }

    p {
      font-size: 14px;
    }
  }

  .project-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background-color: var(--bg-dark);
    height: 112px;
    text-decoration: none;
    color: var(--text);

    box-shadow:
      1px 0 0 0 var(--border),
      0 1px 0 0 var(--border),
      1px 1px 0 0 var(--border),
      1px 0 0 0 var(--border) inset,
      0 1px 0 0 var(--border) inset;
  }

  .project-img {
    height: 60px;
    width: 60px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 0.2rem;

    > svg {
      fill: var(--text);
    }
  }
</style>
