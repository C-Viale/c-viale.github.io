---
interface Props {
  label: string;
  href: string;
  button?: boolean;
  replace?: boolean;
  class?: string;
  highlight?: boolean
}

const { label, button, href, class: className, highlight } = Astro.props;

const externalLink = href.startsWith("http");
---

<a
  class:list={["anchor", { btn: button, highlight }, className]}
  href={href}
  target={externalLink ? "_blank" : "_self"}
>{label}</a>

<style is:global>
  .anchor {
    color: var(--text)
    line-height: normal;

    &.highlight {
      text-decoration: underline;
    }

    &.btn {
      color: white;
      height: 40px;
      padding: 0.5rem 1rem;
      background-color: black;
      font-size: 14px;
      display: grid;
      align-items: center;

      box-shadow: -4px 4px 0 0 rgba(0, 0, 0, 0.25);
      font-family: "Silkscreen", sans-serif;
      font-weight: 600;
      font-style: normal;

      transition: all var(--transition);

      &:hover {
        background-color: white;
        color: black !important;
        box-shadow: -4px 4px 0 0 gray;
      }
    }
  }
</style>
