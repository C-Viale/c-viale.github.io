---
interface Props {
  company: string;
  position: string;
  period: string[];
  details: string[];
}

const { company, position, period, details } = Astro.props;
---

<div class="work-experience">
  <h3>
    <span>{company}</span>
    <span class="text-subtle">
      {period.join(" - ")}
    </span>
  </h3>
  <ul class="work-experience-details">
    {details.map((detail) => <li>{detail}</li>)}
  </ul>
</div>

<style is:global>
  .text-subtle {
    color: #bdbdbd;
    font-size: 1rem;
    font-weight: 400;
  }

  .work-experience {
    border: 1px solid #5b5959;
    /* border-radius: 8px; */
    margin-bottom: 1rem;
    padding: 1rem;
    height: 100%;

    > h3 {
      display: flex;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
  }

  .work-experience-details {
    margin-top: 1rem;
    padding-left: 2rem;
  }
</style>
