---
import AppLayout from "#layouts/app-layout.astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, image, imageAlt = "" } = Astro.props;
---

<AppLayout title={`${title} - Caio Viale's Portfolio`}>
  <div id="article-info">
    {image && <Image src={image} alt={imageAlt} height={100} />}
    <h1 id="article-title">{title}</h1>
    <p>{description}</p>
  </div>

  <article class="project-article">
    <div id="article-content">
      <slot />
    </div>
  </article>
</AppLayout>

<style is:global>
  #article-info {
    padding: 3rem 1rem;
    text-align: center;
    flex: 1;

    > h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    > p {
      color: var(--text-subtle);
    }
  }

  #article-content {
    max-width: 906px;
    margin: auto;
  }

  .project-article {
    background-color: var(--bg-dark);
    padding: 0 2rem;

    p {
      text-align: justify;
      margin-bottom: 1rem;
    }
  }
</style>
