---
import AppLayout from "#layouts/app-layout.astro";

import me from "#assets/me.jpg";
import { Image } from "astro:assets";
import Card from "#components/card.astro";
import { projects } from "src/utils/constants/projects";
import ProjectCard from "#components/project-card.astro";
import athens_portal from "#assets/athens-portal/logo.jpeg";

const imgs: Record<string, ImageMetadata> = {
  athens_portal,
};
---

<AppLayout>
  <Card>
    <h1>Projects</h1>
    <br />
    <div>
      {
        projects.map((project) => (
          <ProjectCard
            href={project.href}
            name={project.name}
            name={project.name}
            image={imgs[project.id]}
          />
        ))
      }
    </div>
  </Card>
</AppLayout>

<style is:global>
  #projects-container {
    display: grid;
    grid-template-columns: 300px 300px;
    grid-auto-rows: 1fr;
    max-width: 90vw;
    gap: 2rem;
    justify-content: center;
  }

  .pc img {
    width: 100%;
    height: 100%;
  }
</style>
