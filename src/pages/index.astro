---
import me from "#assets/me.jpg";
import Card from "#components/card.astro";
import Section from "#components/section.astro";
import Skills from "#components/skills.astro";
import { workExperiences } from "src/utils/constants/work-experiences";
import AppLayout from "#layouts/app-layout.astro";
import { Image } from "astro:assets";
---

<AppLayout>
  <Card>
    <h1>Hi</h1>

    <Section name="me">
      <div id="intro">
        <div id="profile-container">
          <Image src={me} alt="An image of myself" />
        </div>
        <div>
          My name is Caio Lima and I'm a dedicated Full-Stack Developer.
          <br /><br />
          With 5 years of programming experience, I specialize in building sophisticated
          web applications.
        </div>
      </div>
      <br />
      <p>
        I am deeply engaged in researching new technologies and advance my
        skills to deliver products that optimize user experiences and
        operational efficiency.
      </p>
    </Section>

    <Skills title="Stack" />

    <Section name="Experience">
      <table>
        <colgroup>
          <col width="35%" />
          <col width="45%" />
          <col width="20%" />
        </colgroup>
        <tbody>
          {
            workExperiences.map((experience) => (
              <tr>
                <td>{experience.company}</td>
                <td>{experience.period.join(" - ")}</td>
                <td>{experience.location}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </Section>

    <Section name="Projects"> todo </Section>
    <Section name="Get in touch">
      <a
        class="anchor-btn"
        target="_blank"
        href="https://linkedin.com/in/caio-vlima"
      >
        Reach me on LinkedIn!
      </a>

      <a
        class="anchor-btn"
        target="_blank"
        href="https://linkedin.com/in/caio-vlima"
      >
        GitHub
      </a>
    </Section>
  </Card>
</AppLayout>

<style is:global>
  #intro {
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
  }

  #me img {
    width: 100px;
    height: 100px;
    /* border-radius: 50px; */
  }

  #profile-container {
    display: flex;
    justify-content: center;
    align-items: center;
    /* height: 100px; */
  }

  #work-experiences > ul {
    list-style: none;
    /* display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-auto-rows: 1fr;
    gap: 1rem; */
  }

  .anchor-btn {
    color: white;
    display: block;
  }

  table {
    width: 100%;
    border-collapse: collapse;

    td {
      padding: 0.2rem 0.5rem;
      border: 1px solid gray;
    }
  }
</style>
